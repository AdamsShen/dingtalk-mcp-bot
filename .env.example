# 复制为 .env 后填写；.env 已被 .gitignore 排除
#
# 钉钉：开发者后台 → 企业内部应用（应用类型选「机器人」）
#       → 机器人配置里「消息接收模式」选「Stream 模式」
#       → 这里的 CLIENT_ID / CLIENT_SECRET 就是应用的 AppKey / AppSecret
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# mcp-gateway：stdio 模式免登录，身份固定为 GATEWAY_LOCAL_USER
GATEWAY_BIN=/Library/git-root/thriftTester/mcp-gateway/.venv/bin/mcp-gateway
GATEWAY_CONFIG=/Users/xmly/.config/mcp-gateway/config.yaml
GATEWAY_LOCAL_USER=dingtalk-bot
# 允许网关放行 dangerous 方法（生产 write/destructive 仍强制 confirm_token）
GATEWAY_LOCAL_ALLOW_DESTRUCTIVE=false

# 机器人行为
DEFAULT_ENV=product          # 未显式指定时用的环境：product / test
ALLOW_INVOKE_RPC=false       # 是否允许机器人调用 invoke_rpc（真正下发 RPC）
SEARCH_LIMIT=5               # search_api 返回条数
CALL_TIMEOUT_SECONDS=90      # 单次 MCP 调用超时
MAX_REPLY_CHARS=3500         # 回帖截断长度
LOG_LEVEL=INFO
